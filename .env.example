# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# LLM Providers (Configure at least one)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
OCR_API_KEY=

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash

# DeepSeek V4.1 Flash research runs (model alias: deepseek-flash)
DEEPSEEK_API_KEY=
ARTEMIS_MODEL_PROVIDER=openrouter
ARTEMIS_DEEPSEEK_MODEL=deepseek-flash
# Thinking is an experiment switch; enable with 1 when the model API returns reasoning_content.
ARTEMIS_THINKING_ENABLED=0
# Optional independent trace observer. The observer never receives ground-truth labels.
ARTEMIS_OBSERVER_API_KEY=
ARTEMIS_OBSERVER_MODEL=deepseek-flash
ARTEMIS_OBSERVER_BASE_URL=https://api.deepseek.com/v1
ARTEMIS_CHECKER_DEVICE_PROBES=1
ARTEMIS_CHECKER_CLAIM_BLIND=0
ARTEMIS_PASS_GUARD=0
# fused is baseline; use tree or screenshot for evidence ablations
ARTEMIS_CHECKER_EVIDENCE_MODE=fused

# Optional screenshot reviewer using an OpenAI-compatible vision endpoint.
# Select a model that accepts image_url inputs and JSON output.
ARTEMIS_VISION_API_KEY=
ARTEMIS_VISION_MODEL=
ARTEMIS_VISION_BASE_URL=https://openrouter.ai/api/v1
# AndroidWorld uses an isolated Python 3.11 environment and a dedicated emulator.
# Defaults point to the sibling android_world checkout and its .venv.
# ARTEMIS_ANDROIDWORLD_PATH=/absolute/path/to/android_world
# ARTEMIS_ANDROIDWORLD_PYTHON=/absolute/path/to/android_world/.venv/bin/python
ARTEMIS_ANDROIDWORLD_GRPC_PORT=8554

# OpenRouter credential and official DeepSeek snapshot routing.
# OPEN_ROUTER_API_KEY is defined in the provider section above.
ARTEMIS_OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
ARTEMIS_OPENROUTER_ONLY_PROVIDER=deepseek
