# BagelBench device-host configuration. Agent credentials belong to Harbor.
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=emulator-5554
BAGEL_KEEP_DEVICE_AWAKE=true
BAGEL_HIERARCHY_BACKEND=auto
BAGEL_HELPER_AUTO_INSTALL=true
# Set a secret verifier token in the device host and Harbor environments.
BAGEL_BENCH_VERIFIER_TOKEN=
# Existing installed AVD name. Override it for a different dedicated emulator.
BAGEL_ANDROID_AVD=ArtemisAndroidWorld
# Optional historical AndroidWorld dataset tools.
# BAGEL_ANDROIDWORLD_PATH=/absolute/path/to/android_world
# BAGEL_ANDROIDWORLD_PYTHON=/absolute/path/to/android_world/.venv/bin/python
BAGEL_ANDROIDWORLD_GRPC_PORT=8554
